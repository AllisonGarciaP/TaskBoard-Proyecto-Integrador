+                    'metodo_pago' => $attributes['metodo_pago'],
+                    'estado' => $attributes['estado'],
+                ]
+            );
+
+            if ($transaccion->estado !== 'Iniciada') {
+                $transaccion->eventos()->firstOrCreate(
+                    ['estado_nuevo' => $transaccion->estado],
+                    ['estado_anterior' => 'Iniciada']
+                );
+            }
+        }
+    }
+}
